<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageView
            android:id="@+id/imgMemory"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:scaleType="centerCrop"
            android:src="@drawable/couplemiy"
            android:layout_marginEnd="12dp"
             />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvMemoryTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="First Date"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@android:color/black" />

            <TextView
                android:id="@+id/tvMemoryDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2024-02-14"
                android:textColor="#888888"
                android:textSize="13sp"
                android:paddingTop="2dp" />

            <TextView
                android:id="@+id/tvMemoryDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Our first dinner together ❤️"
                android:textSize="14sp"
                android:textColor="#444444"
                android:paddingTop="6dp" />
        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
