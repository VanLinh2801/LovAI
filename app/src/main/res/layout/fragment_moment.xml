<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    tools:context=".Frag.MomentFragment">

    <!-- Header -->
    <TextView
        android:id="@+id/tvMomentsTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Moments"
        android:textSize="22sp"
        android:textStyle="bold"
        android:padding="16dp"
        android:textColor="@android:color/black" />

    <!-- Danh sách kỉ niệm -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMoments"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/tvMomentsTitle"
        android:padding="8dp"/>

    <!-- Nút bắt đầu đi chơi -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnStartTrip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_margin="16dp"
        android:contentDescription="Bắt đầu đi chơi"
        app:srcCompat="@drawable/ic_add" />

</RelativeLayout>
